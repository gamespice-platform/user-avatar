# Godot 4
.godot/
/android/

# gs-core is a separate repository. For local development, symlink it:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy both addons into their own project.
/addons/gs_core

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# gs-save: the file stores sit on GSSaveStoreFile. For local development, symlink it:
#   ln -s ../../gs-save/addons/gs_save addons/gs_save
# Consumers copy it into their own project beside gs_core.
/addons/gs_save
