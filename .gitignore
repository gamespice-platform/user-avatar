# Godot 4
.godot/
/android/

# dot-core is a separate repository. For local development, symlink it:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# Consumers copy both addons into their own project.
/addons/dot_core

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# dot-save: the file stores sit on DotSaveStoreFile. For local development, symlink it:
#   ln -s ../../dot-save/addons/dot_save addons/dot_save
# Consumers copy it into their own project beside dot_core.
/addons/dot_save
